# Copy to .env and fill in. Never commit the real .env.

# --- Database ---------------------------------------------------------------
# Local development uses SQLite out of the box:
DATABASE_URL="file:./dev.db"

# For production (PostgreSQL), run `npm run db:use-postgres` first, then set:
#   DATABASE_URL  pooled connection  (Supabase: port 6543, ?pgbouncer=true)
#   DIRECT_URL    direct connection  (Supabase: port 5432) — used by migrations
# DATABASE_URL="postgresql://user:pass@host:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_URL="postgresql://user:pass@host:5432/postgres"

# --- App --------------------------------------------------------------------
# Public origin. Used to build checkout return URLs, so it must be correct.
APP_URL="http://localhost:3100"

# --- Payments (Dodo) --------------------------------------------------------
# Until all three are set, checkout runs in a clearly-labelled test mode that
# takes no money. See src/lib/payments/dodo.ts.
DODO_API_KEY=""
DODO_WEBHOOK_SECRET=""
DODO_PRODUCT_ID=""

# --- Google sign-in (optional) ----------------------------------------------
# The button stays disabled until both are set.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Datafast analytics (public site id, safe to commit as an example)
NEXT_PUBLIC_DATAFAST_ID=""
NEXT_PUBLIC_DATAFAST_DOMAIN="rankvyze.com"

# Transactional email. Without these the app logs what it would have sent
# and reports notConfigured — it never pretends a mail was delivered.
# 1. Create an API key at resend.com/api-keys
# 2. Verify rankvyze.com as a sending domain (adds 3 DNS records)
RESEND_API_KEY=
EMAIL_FROM="RankVyze <hello@rankvyze.com>"

# 32 random bytes, base64. Encrypts customer integration credentials at rest.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIAL_KEY=
